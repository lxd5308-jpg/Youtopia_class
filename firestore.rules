rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// PHASE 2 — ownership rules.
//
// Ships together with the App.jsx change that stops students subscribing to
// whole collections; deploying this without that change breaks student pages.
//
// No `match /{document=**}` catch-all: rules are permissive-OR, so a
// catch-all would silently re-grant everything. Unlisted paths are denied.
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email()    { return request.auth.token.email.lower(); }

    // Hard-coded so a bad settings write can never lock every teacher out,
    // and so teacher status can never be self-granted from the client.
    // Keep in sync with TEACHER_EMAILS in src/config.js.
    function rootTeacher() {
      return email() in [
        'info@youtopiadanceacademy.com',
        'summerli634@gmail.com',
        'yating8697@gmail.com',
        'anniechang0719@gmail.com',
        'feiafei@gmail.com'
      ];
    }

    // email_verified matters: without it, someone could register an
    // email/password account claiming a teacher's address and inherit access.
    // The runtime allow-list lives in settings/private, which students cannot
    // read. get() inside a rule bypasses rules, so this works for everyone.
    // exists() guards the case where the doc has not been created yet, and
    // .get('teacherEmails', []) the case where the field is missing —
    // either would otherwise error and deny every teacher.
    function allowListTeacher() {
      return exists(/databases/$(database)/documents/settings/private)
        && email() in get(/databases/$(database)/documents/settings/private).data.get('teacherEmails', []);
    }

    function isTeacher() {
      return signedIn()
        && request.auth.token.email_verified == true
        && (rootTeacher() || allowListTeacher());
    }

    // students/{id} is keyed by encodeURIComponent(email), so for a normal
    // address the only escaped character is '@' -> '%40'. Addresses with '+'
    // (or other escapable characters) will not match; storing an `email`
    // field on the doc and comparing that is the robust follow-up.
    function ownStudentDoc(id) {
      let parts = email().split('@');
      return signedIn() && parts.size() == 2 && id.lower() == parts[0] + '%40' + parts[1];
    }

    function owns()    { return signedIn() && resource.data.studentEmail.lower() == email(); }
    function willOwn() { return signedIn() && request.resource.data.studentEmail.lower() == email(); }

    // ── Shared configuration ────────────────────────────────────────────
    // settings/main holds ONLY the class list and semester dates, which every
    // student page needs. Rules are per-document, not per-field, so anything
    // students must not read has to live in a different document —
    // that is settings/private (teacherEmails, emailConfig, summary schedule).
    match /settings/main {
      allow read:  if signedIn();
      allow write: if isTeacher();
    }
    // Covers settings/private and any future config doc: teachers only.
    match /settings/{other} {
      allow read, write: if isTeacher();
    }

    // ── Per-student profile ─────────────────────────────────────────────
    match /students/{sid} {
      allow read, write: if isTeacher() || ownStudentDoc(sid);
    }

    // ── Student-submitted records ───────────────────────────────────────
    // Students may create their own and read their own. Status decisions
    // (confirm / reject / resolve) stay teacher-only — a student must never
    // be able to mark their own payment confirmed.
    match /payments/{id} {
      allow read:           if isTeacher() || owns();
      allow create:         if isTeacher() || willOwn();
      allow update, delete: if isTeacher();
    }

    // A make-up is stored as a nested object on the student's own leave
    // request, so students must be able to update these documents —
    // requestMakeup() writes {makeup} onto an existing doc, and by design it
    // is auto-approved client-side (status:'approved').
    // Once a teacher has ruled on it, resolveMakeup() stamps makeup.resolvedAt;
    // from that point the document is teacher-only, so a student cannot
    // overwrite a decline with another auto-approved make-up.
    function makeupResolvedByTeacher() {
      return resource.data.get('makeup', {}).get('resolvedAt', '') != '';
    }

    match /leaveRequests/{id} {
      allow read:   if isTeacher() || owns();
      allow create: if isTeacher() || willOwn();
      // Owner before and after, so a student cannot reassign it to someone else.
      allow update: if isTeacher() || (owns() && willOwn() && !makeupResolvedByTeacher());
      allow delete: if isTeacher();
    }

    // Enrollment docs are created by the student sign-up flow and re-written
    // with merge:true if they enrol in the same class again.
    match /enrollments/{id} {
      allow read:   if isTeacher() || owns();
      allow create: if isTeacher() || willOwn();
      allow update: if isTeacher() || (owns() && willOwn());
      allow delete: if isTeacher();
    }

    // Created by the student sign-up flow; session logging is a teacher action.
    match /sessionPacks/{id} {
      allow read:           if isTeacher() || owns();
      allow create:         if isTeacher() || willOwn();
      allow update, delete: if isTeacher();
    }

    // Teacher-side ledger. No student page reads it (students get their
    // history from their own students/{id} doc) and the existing documents
    // carry no studentEmail, so this is teacher-only.
    match /paymentHistory/{id} {
      allow read, write: if isTeacher();
    }

    // Switch/drop audit trail, written only by the teacher-initiated
    // switchStudentClass/dropStudentClass actions — never by a student
    // directly — so this is teacher-only like paymentHistory.
    match /classChangeLog/{id} {
      allow read, write: if isTeacher();
    }

    // ── Messaging ───────────────────────────────────────────────────────
    match /studentInbox/{id} {
      allow read:   if isTeacher() || owns();
      allow create: if isTeacher() || willOwn();
      allow update: if isTeacher() || (owns() && willOwn());
      allow delete: if isTeacher();
    }

    match /teacherMessages/{id} {
      allow read:  if isTeacher() || owns();
      allow write: if isTeacher();
    }
  }
}
